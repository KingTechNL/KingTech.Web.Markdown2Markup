@using KingTech.Web.Markdown2Markup.Models
@using KingTech.Web.Markdown2Markup.WebService.Repositories
@using KingTech.Web.Markdown2Markup.WebService.Services
@using KingTech.Web.Markdown2Markup.WebService.Settings
@using Microsoft.Extensions.Options
@inject IBlogService blogService
@inject IOptions<GeneralSettings> generalSettings


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @if (string.IsNullOrWhiteSpace(logo))
        {
            <a class="navbar-brand" href="">@title</a>
        }
        else
        {
            @((MarkupString)logo)
        }
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />


<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <!-- Main Nav Item -->
        @if (insertHome)
        {
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="@homeRef">Home</NavLink>
            </li>
        }

        <!-- Chapters -->
        @foreach(var chapter in tableOfContents){
            <ChapterNavItem Chapter="chapter"/>
        }
    </nav>
</div>



@code{
    private string title;
    private string logo;
    private List<TableOfContentsNode> tableOfContents;

    private bool insertHome;
    private string homeRef;

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        title = generalSettings.Value?.Title ?? string.Empty;
        logo = generalSettings.Value?.Logo ?? string.Empty;
        insertHome = generalSettings.Value?.InsertHomeItem ?? false;
        homeRef = blogService.GetMainPage();
        tableOfContents = blogService.GetTableOfContents();
    }
}