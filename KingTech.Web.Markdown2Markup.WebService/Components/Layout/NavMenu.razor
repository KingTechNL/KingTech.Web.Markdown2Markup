@using KingTech.Web.Markdown2Markup.Models
@using KingTech.Web.Markdown2Markup.WebService.Repositories
@using KingTech.Web.Markdown2Markup.WebService.Services
@using KingTech.Web.Markdown2Markup.WebService.Settings
@using Microsoft.Extensions.Options
@inject IBlogService blogService
@inject IOptions<GeneralSettings> generalSettings


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @if(!string.IsNullOrWhiteSpace(_logoImage))
        {
            <!-- Basic logo image -->
            <a class="navbar-brand" href="@_homeRef"><img src="@_logoImage" class="navbar-brand-image" width="100%"></a>
        }
        else if (!string.IsNullOrWhiteSpace(_logo))
        {
            <!-- Custom logo HTML -->
            @((MarkupString)_logo)
        }
        else 
        {
            <!-- Show title -->
            <a class="navbar-brand" href="@_homeRef">@_title</a>
        }
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <!-- Main Nav Item -->
        @if (_insertHome)
        {
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="@_homeRef">Home</NavLink>
            </li>
        }

        <!-- Chapters -->
        @foreach(var chapter in _tableOfContents){
            <ChapterNavItem Chapter="chapter"/>
        }
    </nav>
</div>



@code{
    private string _title = string.Empty;
    private string _logo = string.Empty;
    private string _logoImage = string.Empty;
    private List<TableOfContentsNode> _tableOfContents = new();

    private bool _insertHome;
    private string _homeRef = string.Empty;

    /// <inheritdoc/>
    protected override Task OnInitializedAsync()
    {
        _title = generalSettings.Value?.Title ?? string.Empty;
        _logo = generalSettings.Value?.Logo ?? string.Empty;
        _logoImage = generalSettings.Value?.LogoImage ?? string.Empty;
        _insertHome = generalSettings.Value?.InsertHomeItem ?? false;
        _homeRef = string.IsNullOrWhiteSpace(generalSettings.Value?.HomeUrl) ? blogService.GetMainPage() : generalSettings.Value?.HomeUrl ?? string.Empty;
        _tableOfContents = blogService.GetTableOfContents();

        return Task.CompletedTask;
    }
}