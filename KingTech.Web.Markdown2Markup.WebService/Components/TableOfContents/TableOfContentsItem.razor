@using System.Web
@using KingTech.Web.Markdown2Markup.Models
@inject NavigationManager NavigationManager

@if (HasSubItems)
{
    <li>
        <a class="toc-item" href=@GetFullHref(Item.HRef)>@Item.Name</a>
        <ul>
            @foreach (var subChapter in Item.SubChapters)
            {
                <TableOfContentsItem Item="subChapter" />
            }
        </ul>
    </li>
}
else
{
    <li><a class="toc-item" href=@GetFullHref(Item.HRef)>@Item.Name</a></li>
}

@code {
    /// <summary>
    /// The chapter this nav item is created for.
    /// </summary>
    [Parameter]
    public TableOfContentsNode Item { get; set; }


    /// <summary>
    /// Indicates whether this item has sub-items.
    /// </summary>
    public bool HasSubItems => Item.SubChapters?.Any() == true;



    private string GetFullHref(string? href)
    {
        if (string.IsNullOrEmpty(href))
            return "#";

        // Get the current path without the fragment
        var currentUri = new Uri(NavigationManager.Uri);
        var currentPath = currentUri.GetLeftPart(UriPartial.Path);

        // If href already starts with #, prepend the current path
        return $"{currentPath}#{href}";
    }
}