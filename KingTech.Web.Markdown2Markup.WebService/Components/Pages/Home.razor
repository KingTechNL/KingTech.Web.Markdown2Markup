@page "/"
@page "/{Reference}"
@using KingTech.Web.Markdown2Markup.Models
@using KingTech.Web.Markdown2Markup.WebService.Repositories
@using KingTech.Web.Markdown2Markup.WebService.Services
@inject IBlogService blogService


@((MarkupString)Content)


@code{
    [Parameter]
    public string? Reference { get; set; }
    public string? Content { get; set; }

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        
    }

    /// <inheritdoc/>
    protected override async Task OnParametersSetAsync()
    {
        Content = blogService.GetContent(Reference ?? blogService.GetMainPage());
    }
}