@using KingTech.Web.Markdown2Markup.Models

<ul>
    @foreach (var chapter in Chapters)
    {
        <li>
            <a href="#@chapter.Name">@chapter.Name</a>
            @if (chapter.SubChapters?.Any() == true)
            {
                <Navigation Chapters="chapter.SubChapters" />
            }
        </li>
    }
</ul>


@code {
    [Parameter]
    public List<TableOfContentsNode> Chapters { get; set; } = new();
}

